    <!-- Wizard -->
    <string name="wizard_title">Kreator konfiguracji</string>
    <string name="wizard_step">Krok %1$d z %2$d</string>
    <string name="wizard_step1_title">1. Przypisz przycisk SOS do ClickLog</string>
    <string name="wizard_step1_text">W ustawieniach systemu otwórz „Przycisk programowalny” (Programmable Key). Przypisz krótkie naciśnięcie do aplikacji ClickLog – jeśli lista pokazuje dwa wpisy, wybierz „ClickLog – przycisk”. Wyłącz domyślną akcję SOS / połączenia alarmowego, żeby przycisk nie dzwonił pod numer alarmowy.</string>
    <string name="wizard_step1_open_settings">Otwórz ustawienia systemu</string>
    <string name="wizard_step2_title">2. Włącz usługę dostępności</string>
    <string name="wizard_step2_text">Usługa dostępności pozwala odbierać przycisk jako KeyEvent także przy zgaszonym ekranie (ścieżka A). Otwórz ustawienia dostępności, znajdź „ClickLog – przycisk SOS” i włącz. Jeśli system nie pozwoli, kreator użyje ścieżki B.</string>
    <string name="wizard_step2_open">Otwórz ustawienia dostępności</string>
    <string name="wizard_step2_status_on">Usługa dostępności: włączona ✔</string>
    <string name="wizard_step2_status_off">Usługa dostępności: wyłączona</string>
    <string name="wizard_step3_title">3. Test przycisku</string>
    <string name="wizard_step3_text">Naciśnij teraz przycisk SOS 3 razy. Nie dotykaj ikony aplikacji ani innych klawiszy. Aplikacja nasłuchuje na wszystkich kanałach i pokazuje na żywo, co dociera.</string>
    <string name="wizard_step3_presses">Wykryte naciśnięcia: %1$d / 3</string>
    <string name="wizard_step3_time_left">Pozostało: %1$d s</string>
    <string name="wizard_step3_live">Zdarzenia na żywo</string>
    <string name="wizard_step3_nothing_yet">Jeszcze nic nie dotarło…</string>
    <string name="wizard_step3_start">Rozpocznij test</string>
    <string name="wizard_step3_summary">Podsumowanie</string>
    <string name="wizard_summary_counts">Usługa dostępności: %1$d · Activity: %2$d · Intenty: %3$d · Broadcasty: %4$d · Media: %5$d</string>
    <string name="wizard_reason_accessibility">Usługa dostępności widzi przycisk (keycode %1$d). Wybrano ścieżkę A.</string>
    <string name="wizard_reason_activity_only">Przycisk dociera do ekranu aplikacji (keycode %1$d), ale usługa dostępności go nie przechwytuje – ścieżka A nie zadziała w tle. Zostanie użyta ścieżka B.</string>
    <string name="wizard_reason_launch">System uruchamia aplikację przy naciśnięciu. Wybrano ścieżkę B (LAUNCH_INTENT).</string>
    <string name="wizard_reason_none">Nie wykryto przycisku.</string>
    <string name="wizard_checklist_title">Sprawdź:</string>
